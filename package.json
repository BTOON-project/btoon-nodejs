{
  "name": "btoon",
  "version": "0.1.0",
  "description": "BTOON for Node.js: compact binary serialization — MessagePack plus columnar tables, timestamps, bigints and vectors (native)",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "binding.gyp",
    "src/",
    "scripts/core-path.js",
    "prebuilds/",
    "core/include/btoon/*.h",
    "core/src/*.cpp",
    "core/src/*.h",
    "core/LICENSE",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "build": "node-gyp rebuild",
    "prebuilds": "prebuildify --napi --strip --target 18.0.0",
    "test": "node --test test/api.test.js test/vectors.test.js",
    "examples": "node examples/01-basic.js && node examples/02-compression.js && node examples/03-tabular.js && node examples/04-streaming.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BTOON-project/btoon-nodejs.git"
  },
  "keywords": ["btoon", "binary", "serialization", "messagepack", "msgpack", "tabular", "columnar", "compression", "napi"],
  "author": "BTOON Contributors",
  "license": "MIT",
  "homepage": "https://btoon.net",
  "bugs": "https://github.com/BTOON-project/btoon-nodejs/issues",
  "gypfile": true,
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "node-gyp": "^13.1.0",
    "prebuildify": "^6.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
